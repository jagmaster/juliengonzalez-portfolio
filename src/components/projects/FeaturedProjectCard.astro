---
interface Props {
    title: string;
    descriptionShort: string;
    cover: string;
    coverAlt: string;
    href: string;
    categories: string[];
}

const { title, descriptionShort, cover, coverAlt, href, categories } =
    Astro.props;
---

<article
    class="home__work flex flex-col lg:flex-row justify-start gap4 lg:gap-6 pt-6"
>
    <div
        data-aos="fade-right"
        data-aos-offset="300"
        data-aos-easing="ease-in-out"
        data-aos-delay="200"
        class="home__work__cover max-w-fit rounded-3xl overflow-hidden"
    >
        <a href={href}>
            <img
                src={cover}
                alt={coverAlt}
                width="690"
                height="388"
                loading="lazy"
            />
        </a>
    </div>

    <div
        data-aos="fade-right"
        data-aos-offset="300"
        data-aos-easing="ease-in-out"
        data-aos-delay="400"
        class="project_infos lg:border-t-4 border-stone-950 pt-6 px-3"
    >
        <h3
            class="project_title mb-2 text-2xl md:text-3xl lg:text-4xl font-extrabold"
        >
            {title}
        </h3>
        <p class="project_description mb-6 text-stone-700 max-w-md text-base">
            {descriptionShort}
        </p>
        <ul
            class="mb-10 flex flex-row justify-start items-start gap-2 text-sm uppercase"
        >
            {
                categories.map((category) => (
                    <li class="category-tag">
                        <span class="px-4 py-2 cursor-default">{category}</span>
                    </li>
                ))
            }
        </ul>
        <a href={href} class="btn--large"> Voir le projet </a>
    </div>
</article>
