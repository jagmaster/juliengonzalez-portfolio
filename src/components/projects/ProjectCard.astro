---
interface Props {
  title: string;
  descriptionShort: string;
  cover: string;
  coverAlt: string;
  href: string;
  categories: string[];
}

const {
  title,
  descriptionShort,
  cover,
  coverAlt,
  href,
  categories,
} = Astro.props;
---

<article class="work">
    <div data-aos="flip-down" data-aos-easing="ease-in-out" data-aos-delay="400" class="work__cover max-w-fit rounded-3xl overflow-hidden">
        <a href={href}>
            <img src={cover} alt={coverAlt} width="587" height="328" loading="lazy">
        </a>
    </div>
    <div data-aos="fade-up" data-aos-easing="ease-in-out" data-aos-delay="600" class="work__body">
        <!-- <div class="max-w-[486px] mb-6"> -->
        <div class="max-w-121.5 mb-6">
            <h3 class="work__title py-3 text-2xl md:text-3xl lg:text-[40px] text-stone-950 font-extrabold leading-10">
                {title}
            </h3>
            <p class="work__description text-stone-700">
                {descriptionShort}
            </p>
        </div>
        <ul class="flex flex-row justify-start items-start gap-2 text-sm uppercase">
            {categories.map((category) => (
                <li class="category-tag">
                  <span class="px-4 py-2 cursor-default">{category}</span>
                </li>
            ))}
        </ul>
    </div>
    <div data-aos="fade-up" data-aos-easing="ease-in-out" data-aos-delay="500" class="work__cta pt-14 h-fit">
        <div class="max-w-fit">
            <a href={href} class="btn--large">
                Voir le projet
            </a>
        </div>
    </div>
</article>