                </li>- -->
                <li class="transition-all duration-300 hover:text-stone-200">
                    <a href="/mentions-legales">Mentions Légales</a>
                </li>-
                <li class="transition-all duration-300 hover:text-stone-200">
                    <a href="/politique-de-confidentialite">Politiques de confidentialité</a>
                </li>
                <!-- <li class="transition-all duration-300 hover:text-stone-200">
                    <a href="/">C.G.V.</a>
