---
import { getCollection } from "astro:content";
import Layout from "../layouts/layout.astro";
import Services from "../components/Sevices.astro";
import FeaturedProjectCard from "../components/projects/FeaturedProjectCard.astro";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Julien Gonzalez"
  description="Découvrez le portfolio de Julien Gonzalez, Web Designer et développeur web."
>


<!-- md:text-[4rem] -->
			<section class="md:pt-20 bg-stone-50 hero text-neutral-50 md:h-dvh flex flex-col justify-start md:justify-center items-center">
				<div class="container box-border mx-auto px-4 md:px-20 text-center h-full flex flex-col justify-center items-center">
					<div class="hero__content text-stone-950 flex flex-col justify-center items-start md:items-center gap-4 md:gap-6">
						<div data-aos="zoom-in" data-aos-easing="ease-in-out" class="img-container rounded-full overflow-hidden max-h-28 md:max-h-32 max-w-28 md:max-w-32">
							<img src="img/pp.jpg" alt="Photo de profil de Julien Gonzalez" width="128px" height="128px">
						</div>
						<h1
							data-aos="fade-up"
							data-aos-easing="ease-in-out"
							id="jobName"
							
							class="max-w-4xl text-5xl md:text-6xl  leading-10 md:leading-16 font-black headline text-left md:text-center">
							<!-- D.A. - Web Designer & Développeur Web Front-end -->
							D.A. - Web Designer & Développeur Front-End
						</h1>
						<p 
							data-aos="fade-up"
							data-aos-easing="ease-in-out"
							data-aos-delay="300"
							class="text-stone-700 text-lg max-w-md hero__description text-left md:text-center">
							Je conçois et développe des sites web sur mesure, élégants et centrés sur l’expérience utilisateur.
						</p>
						<div class="cta w-full md:pb-0 flex flex-col md:flex-row justify-center items-center gap-3 md:gap-6">
							<a
								data-aos="flip-down"
								data-aos-delay="700"
								href="/projects" class="btn--large w-full md:w-fit">
								Voir les projets
							</a>
							<a 
								data-aos="flip-down"
								data-aos-delay="700"
								href="#contact" class="btn--large w-full md:w-fit">
							Me contacter</a>
						</div>
					</div>
				</div>
				<div class="clients py-10">
					<ul class="logos hidden md:flex flex-row justify-center items-center gap-4">
						<li 
							data-aos="fade-right"
							data-aos-delay="800"
							data-aos-easing="ease-in-out"
							data-aos-anchor="#jobName"
							class="logo flex justify-center items-center px-10">
							<img src="/img/logos/grain.svg" alt="logo de Grain&Co.">
						</li>
						<li
							data-aos="fade-right"
							data-aos-delay="1000"
							data-aos-easing="ease-in-out" 
							data-aos-anchor="#jobName"
							class="logo flex justify-center items-center px-10">
							<img src="/img/logos/flowriders.svg" alt="logo de Grain&Co.">
						</li>
						<li
							data-aos="fade-right"
							data-aos-delay="1300" 
							data-aos-easing="ease-in-out"
							data-aos-anchor="#jobName"
							class="logo flex justify-center items-center px-10">
							<img src="/img/logos/trame.svg" alt="logo de Grain&Co.">
						</li>
						<li
							data-aos="fade-right"
							data-aos-delay="1600" 
							data-aos-easing="ease-in-out"
							data-aos-anchor="#jobName"
							class="logo flex justify-center items-center px-10">
							<img src="/img/logos/gouv.svg" alt="logo de Grain&Co.">
						</li>
						<li
							data-aos="fade-right"
							data-aos-delay="1800" 
							data-aos-easing="ease-in-out"
							data-aos-anchor="#jobName"
							class="logo flex justify-center items-center px-10">
							<img src="/img/logos/urbanbliss.svg" alt="logo de Grain&Co.">
						</li>
					</ul>
				</div>
			</section>
